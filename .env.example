# Copia este archivo como ".env" y coloca los valores de
# Firebase Console → Configuración del proyecto → Tus apps → App web.
# En Netlify se capturan en: Site configuration → Environment variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Solo para desarrollo local con emuladores (npm run emulators). Déjalo en false en Netlify.
VITE_USE_EMULATORS=false
